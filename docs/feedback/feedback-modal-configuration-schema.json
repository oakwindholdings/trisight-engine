{
    "ESCALATOR": {
      "displayName": "Escalator Pattern",
      "metadataFields": ["startIndex", "endIndex", "direction", "steps", "averageStepHeight", "stepConsistency", "signalStrength"],
      "feedbackControls": [
        {
          "type": "confidence-slider",
          "label": "Pattern Accuracy",
          "field": "accuracy"
        },
        {
          "type": "thumbs",
          "label": "Valid Pattern?",
          "field": "isValid"
        },
        {
          "type": "multiselect",
          "label": "Step Quality Issues",
          "field": "stepIssues",
          "options": ["missing_steps", "false_steps", "inconsistent_height", "wrong_direction"]
        },
        {
          "type": "timing-scale",
          "label": "Entry Timing",
          "field": "timingAssessment"
        },
        {
          "type": "text",
          "label": "Additional Notes",
          "field": "notes"
        }
      ],
      "notesMergeTemplate": "Escalator {{direction}} with {{steps.length}} steps. Analyst: {{notes}}",
      "feedEventTypes": ["PATTERN", "TRADE_ENTRY"],
      "color": "#8E24AA"
    },
    
    "ESCALATOR_STEP": {
      "displayName": "Escalator Step",
      "metadataFields": ["stepRef", "direction", "floor", "ceiling", "height", "startIndex", "endIndex"],
      "feedbackControls": [
        {
          "type": "thumbs",
          "label": "Valid Step?",
          "field": "isValidStep"
        },
        {
          "type": "multiselect",
          "label": "Step Issues",
          "field": "stepBoundaryIssues",
          "options": ["floor_incorrect", "ceiling_incorrect", "not_a_step", "merged_steps"]
        },
        {
          "type": "text",
          "label": "Step Notes",
          "field": "stepNotes"
        }
      ],
      "notesMergeTemplate": "Step {{stepRef}} {{direction}}. Floor: {{floor}}, Ceiling: {{ceiling}}. {{stepNotes}}",
      "feedEventTypes": ["LABEL"],
      "color": "#8E24AA"
    },
    
