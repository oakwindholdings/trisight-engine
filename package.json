  "scripts": {
    "start": "set \"SKIP_PREFLIGHT_CHECK=true\" && set \"TSC_COMPILE_ON_ERROR=true\" && react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:unit": "react-scripts test --watchAll=false --testPathIgnorePatterns=\"(integration|stress|e2e|real|demo)\" --coverage",
    "test:integration": "react-scripts test --watchAll=false --testPathPattern=\"(integration|real)\" --testTimeout=30000",
    "test:all": "react-scripts test --watchAll=false --coverage",
    "test:watch": "react-scripts test",
    "audit:sigint": "ts-node src/utils/audit/SignalIntegrityAuditDemo.ts",
    "test:charts": "react-scripts test --watchAll=false --testNamePattern=\"Pattern Rendering\"",
    "lint": "eslint src --ext .ts,.tsx",
    "eject": "react-scripts eject",
    "build:reportgen": "webpack --config webpack.reportgen.config.js",
    "server:install": "cd server && npm install",
    "server:start": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "dev": "concurrently \"npm start\" \"npm run server:dev\"",
    "test:report:unit": "cd src/reportGeneration && jest --config jest.config.js __tests__/unit",
    "test:report:integration": "cd src/reportGeneration && jest --config jest.config.js __tests__/integration",
    "test:report:coverage": "cd src/reportGeneration && jest --config jest.config.js --coverage",
    "test:report:watch": "cd src/reportGeneration && jest --config jest.config.js --watch",
    "test:report:all": "cd src/reportGeneration && jest --config jest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "npm run test:unit && npm run test:e2e",
    "deploy": "echo deploys via Railway on push to main (CI-gated)"
  },
  "homepage": "./",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
