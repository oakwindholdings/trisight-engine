# Production Environment Variables for TriSight
# Copy this file to .env and replace with your actual values

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# TwelveData API Configuration
REACT_APP_TWELVE_DATA_API_KEY=your-twelve-data-api-key-here

# Feature Flags
REACT_APP_FEEDBACK_ENABLED=true
REACT_APP_LEARNING_ENABLED=true
REACT_APP_CONSENT_REQUIRED=true

# Optional: Sentry for error monitoring
# REACT_APP_SENTRY_DSN=your-sentry-dsn-here

# Build Configuration
SKIP_PREFLIGHT_CHECK=true
TSC_COMPILE_ON_ERROR=true
CI=false 