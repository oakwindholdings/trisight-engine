{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PatternFeedEntry",
  "description": "MCP-compliant schema for TriSight pattern feed entries.",
  "type": "object",
  "required": [
    "id",
    "symbol",
    "patternType",
    "eventType",
    "timestamp",
    "mcpVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z]{1,5}$"
    },
    "sector": {
      "type": "string"
    },
    "patternType": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": ["PATTERN", "TRADE_ENTRY", "STOP_EXIT", "TRADE_BIAS"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "humanSummary": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "renderHints": {
      "type": "object",
      "properties": {
        "emphasis": { "enum": ["bull", "bear"] }
      },
      "additionalProperties": true
    },
    "mcpVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "userId": {
      "type": "string"
    },
    "reviewed": {
      "type": "boolean"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}